#!/bin/sh
# Pre-commit hook for ConnectWiseAutomateAgent.
# Runs PSScriptAnalyzer and the Pester tests before allowing a commit.
#
# Setup: git config core.hooksPath .githooks
#
# Git runs hooks through sh, and pwsh only accepts -File for a .ps1 file, so the
# checks live in pre-commit.ps1 and this file only starts it.
exec pwsh -NoProfile -NonInteractive -File "$(dirname "$0")/pre-commit.ps1"
